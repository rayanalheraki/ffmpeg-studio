{
  "name": "ffmpeg-studio",
  "productName": "FFmpeg Studio",
  "version": "1.0.0",
  "description": "A calm, modern desktop GUI for FFmpeg: convert, edit and batch-process media files with very little effort.",
  "author": "FFmpeg Studio contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-binaries.mjs && tauri dev",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "package": "npm run typecheck && node scripts/prepare-binaries.mjs && tauri build",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/cairo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-notification": "2.8.0",
    "@types/ffprobe-static": "2.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "globals": "17.13.0",
    "lucide-react": "1.64.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
